<?xml version="1.0"?>
<config>
    <tabs>
        <basicrum_analytics translate="label">
            <label>BasicRUM Analytics</label>
            <sort_order>9999</sort_order>
        </basicrum_analytics>
    </tabs>
    <sections>
        <basicrum_analytics translate="label">
            <label>Configuration</label>
            <tab>basicrum_analytics</tab>
            <frontend_type>text</frontend_type>
            <sort_order>100</sort_order>
            <show_in_default>1</show_in_default>
            <show_in_website>1</show_in_website>
            <show_in_store>1</show_in_store>
            <groups>
                <general translate="label comment">
                    <label>General Settings</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>10</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <comment><![CDATA[<strong style="color: #eb5202;">BasicRUM</strong> - Open Source Real User Monitoring system - <a href="https://www.basicrum.com/" target="_blank">https://www.basicrum.com/</a>]]></comment>
                    <fields>
                        <enabled translate="label">
                            <label>Enable</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>0</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </enabled>
                        <boomerang_version translate="label">
                            <label>Boomerang JS</label>
                            <frontend_type>select</frontend_type>
                            <source_model>basicrum_analytics/system_config_source_version</source_model>
                            <sort_order>1</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <frontend_class>disabled</frontend_class>
                        </boomerang_version>
                        <beacon_endpoint translate="label">
                            <label>Beacon Endpoint URL</label>
                            <frontend_type>text</frontend_type>
                            <frontend_model>basicrum_analytics/adminhtml_system_config_form_field_requiredSetting</frontend_model>
                            <backend_model>basicrum_analytics/system_config_backend_beaconEndpoint</backend_model>
                            <sort_order>2</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <comment>Required. HTTPS is enforced unless HTTP Strictness explicitly allows HTTP for local testing. Example: https://www.example.com/beacon/catcher</comment>
                        </beacon_endpoint>
                        <brum_site_id translate="label comment">
                            <label>BasicRUM Site ID</label>
                            <frontend_type>text</frontend_type>
                            <frontend_model>basicrum_analytics/adminhtml_system_config_form_field_requiredSetting</frontend_model>
                            <backend_model>basicrum_analytics/system_config_backend_siteId</backend_model>
                            <sort_order>3</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <comment><![CDATA[Required UUID v4 provided by Basicrum. Monitoring stays disabled until both this value and the Beacon Endpoint URL are valid. <br /> Example: <strong>e926c1a2-7e33-4f54-90d0-e6e31f3ad43d</strong>]]></comment>
                        </brum_site_id>
                    </fields>
                </general>
                <privacy translate="label">
                    <label>Data Privacy / GDPR</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>15</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <fields>
                        <strip_query_string translate="label comment">
                            <label>Strip Query Strings</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>1</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <comment>When enabled, complete query strings in page, navigation, referrer, and resource URLs are replaced with ?qs-redacted before beacons are sent. URL paths are still collected. Beacon Endpoint URL parameters are not changed.</comment>
                        </strip_query_string>
                        <opt_in_required translate="label">
                            <label>Require Consent Before Monitoring</label>
                            <frontend_type>select</frontend_type>
                            <source_model>basicrum_analytics/system_config_source_consentMode</source_model>
                            <sort_order>2</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <comment>Choose whether Basicrum may begin monitoring immediately or must wait for explicit consent on each page.</comment>
                        </opt_in_required>
                        <consent_integration_info>
                            <frontend_type>note</frontend_type>
                            <frontend_model>basicrum_analytics/adminhtml_system_config_form_field_consentInfo</frontend_model>
                            <sort_order>3</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <depends>
                                <opt_in_required>1</opt_in_required>
                            </depends>
                        </consent_integration_info>
                    </fields>
                </privacy>
                <wait_after_onload translate="label">
                    <label>Wait After Onload</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>20</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <fields>
                        <enabled translate="label">
                            <label>Enable Wait After Onload</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>1</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </enabled>
                        <wait_ms translate="label">
                            <label>Wait After Onload (ms)</label>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number</validate>
                            <sort_order>2</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <comment>Milliseconds to delay the beacon to capture additional metrics. Values are limited to 0–30000 milliseconds (30 seconds); larger values are capped at 30000.</comment>
                            <depends>
                                <enabled>1</enabled>
                            </depends>
                        </wait_ms>
                    </fields>
                </wait_after_onload>
                <developer translate="label">
                    <label>Developer</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>30</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <fields>
                        <development_mode translate="label comment">
                            <label>HTTP Strictness</label>
                            <frontend_type>select</frontend_type>
                            <source_model>basicrum_analytics/system_config_source_httpPolicy</source_model>
                            <sort_order>1</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <comment>Allow HTTP Beacon URLs only for local testing. Keep HTTPS enforcement enabled on production stores.</comment>
                        </development_mode>
                        <use_unminified_loaders translate="label comment">
                            <label>Use Unminified Loaders</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>2</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <comment>Enable to load non-minified loader scripts for debugging purposes.</comment>
                        </use_unminified_loaders>
                    </fields>
                </developer>
            </groups>
        </basicrum_analytics>
    </sections>
</config>
